{
    "name": "vraith/symfony-auth-starter",
    "description": "The Laravel Breeze of Symfony — scaffold complete authentication in minutes",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "authentication",
        "oauth2",
        "google",
        "login",
        "security",
        "scaffolding",
        "starter-kit"
    ],
    "authors": [
        {
            "name": "Vraith",
            "email": "contact@example.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "doctrine/doctrine-bundle": "^2.7",
        "doctrine/orm": "^2.14|^3.0",
        "symfony/console": "^6.4|^7.0",
        "symfony/filesystem": "^6.4|^7.0",
        "symfony/form": "^6.4|^7.0",
        "symfony/framework-bundle": "^6.4|^7.0",
        "symfony/mailer": "^6.4|^7.0",
        "symfony/security-bundle": "^6.4|^7.0",
        "symfony/twig-bundle": "^6.4|^7.0",
        "symfony/validator": "^6.4|^7.0",
        "symfonycasts/reset-password-bundle": "^1.18",
        "symfonycasts/verify-email-bundle": "^1.15"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.0",
        "symfony/phpunit-bridge": "^6.4|^7.0"
    },
    "suggest": {
        "knpuniversity/oauth2-client-bundle": "Required for Google OAuth login (^2.15)",
        "league/oauth2-google": "Required for Google OAuth login (^4.0)"
    },
    "autoload": {
        "psr-4": {
            "Vraith\\AuthStarter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vraith\\AuthStarter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
